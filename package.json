{
  "name": "@voidrift/plugin-routines",
  "version": "0.1.0",
  "description": "VoidRift Routines — saved prompts run on demand, the first first-party plugin.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@voidrift/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@voidrift/core": "^0.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "plugin",
    "plugin": true,
    "description": "Saved prompts (routines) run on demand or from a trigger (§12.3)."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-plugin-routines.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-plugin-routines/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-plugin-routines#readme",
  "keywords": [
    "voidrift",
    "routines",
    "saved",
    "prompts",
    "run"
  ],
  "publishConfig": {
    "access": "public"
  }
}
